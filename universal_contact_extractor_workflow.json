            "displayName": "Switch",
            "category": "Logic & Flow Control",
            "icon": "switch",
            "description": "Route workflow using conditions"
          },
          "isTrigger": false,
          "isPrimaryTrigger": false,
          "inputs": {
            "mode": "rules",
            "rules": [
              {
                "value1": "{{ $json.files?.[0]?.name || $json.files?.[0]?.type || '' }}",
