              {
                "value1": "{{ $json.files?.[0]?.name || $json.files?.[0]?.type || '' }}",
                "operator": "contains",
                "value2": "csv",
                "outputIndex": 1
              },
              {
                "value1": "{{ $json.files?.[0]?.name || $json.files?.[0]?.type || '' }}",
                "operator": "contains",
                "value2": "image",
                "outputIndex": 2
              }
            ],
