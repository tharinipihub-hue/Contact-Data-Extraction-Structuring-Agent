                "description": "Base ID"
              },
              "tableName": {
                "type": "string",
                "description": "Table ID to watch"
              },
              "events": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "add",
                        "update",
                        "remove"
                      ]
                    }
