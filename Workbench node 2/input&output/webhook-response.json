                "credentialId",
                "baseId"
              ],
              "fetchEndpoint": "/api/tools/airtable/tables",
              "labelKey": "name",
              "valueKey": "id",
              "description": "Select the table to watch for changes."
            },
            {
              "fieldName": "events",
              "label": "Events",
