              "Full Name":         "{{ $json.full_name }}",
              "First Name":        "{{ $json.first_name }}",
              "Last Name":         "{{ $json.last_name }}",
              "Designation":       "{{ $json.designation }}",
              "Company":           "{{ $json.company }}",
              "Email":             "{{ $json.email }}",
              "Phone":             "{{ $json.phone }}",
              "Address":           "{{ $json.address }}",
              "City":              "{{ $json.city }}",
              "State":             "{{ $json.state }}",
              "Country":           "{{ $json.country }}",
              "Sector/Industry":   "{{ $json.sector_industry }}",
              "LinkedIn URL":      "{{ $json.linkedin_url }}",
              "Website":           "{{ $json.website }}",
              "Source":            "{{ $json.source }}",
              "Validation Status": "{{ $json.validation_status }}",
              "Duplicate Status":  "{{ $json.duplicate_status }}",
              "Extracted At":      "{{ new Date().toISOString() }}"
            },
            "valueInputOption": "USER_ENTERED"
          }
        },
        "width": 220,
        "height": 94
      },
      {
        "id": "collect-results-pdf",
        "type": "action",
        "position": { "x": 2180, "y": 80 },
        "data": {
          "label": "Collect PDF Results",
          "toolId": "core.set",
          "toolData": {
            "id": "core.set",
            "displayName": "Set Fields",
            "category": "Core  Utilities",
            "provider": "core",
            "operation": "set",
            "description": "Set or update fields"
          },
          "isTrigger": false,
