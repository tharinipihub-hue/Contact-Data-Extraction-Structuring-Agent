          "inputs": {
            "mode": "manual",
            "assignments": [
              { "name": "file_id",  "value": "={{ $node['set-passthrough-fields'].json.file_id }}",  "valueType": "expression" },
              { "name": "batch_id", "value": "={{ $node['set-passthrough-fields'].json.batch_id }}", "valueType": "expression" },
              { "name": "status",   "value": "done",                                                  "valueType": "string" },
              { "name": "contacts", "value": "={{ $node['groq-pdf-extractor'].json.contacts || (Array.isArray($json.contacts) ? $json.contacts : []) }}", "valueType": "expression" }
