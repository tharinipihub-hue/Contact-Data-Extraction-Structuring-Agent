          "toolData": {
            "id": "google.sheets.append_row",
            "displayName": "Append Row",
            "category": "Integrations",
            "provider": "sheets",
            "operation": "sheetsAppendRow",
            "description": "Append a row of data to a sheet"
          },
          "isTrigger": false,
          "isPrimaryTrigger": false,
          "inputs": {
            "credentialId": "",
            "spreadsheetId": "1AZqaSfoyhcjQOLif1xZfeGi9rfMWHwKDRJUaYuArJVE",
            "sheetName": "Contacts",
