{
  "_platform": "agentbuilder",
  "_version": 1,
  "_exportedAt": "2026-09-26T03:00:00.000Z",
  "_description": "Contact Data Extraction Agent - Single File, Short Prompts, llama-3.1-8b-instant",
  "_notes": [
    "Model: llama-3.1-8b-instant (free tier, 1M TPM, 128k context - no 413 errors).",
    "Set Groq credential on all 4 Groq nodes.",
    "Set Mistral credential on mistral-ocr node.",
    "Set Google Sheets credential on all 4 Append Row nodes.",
    "Google Sheet tab must be named 'Contacts' with headers in Row 1.",
    "For each Loop node: manually connect LLM output -> Loop input, Loop LOOP output -> Sheets, Loop DONE output -> Collect Results, Sheets output -> Loop input.",
    "Toggle workflow Active (ON) after import."
  ],
  "workflow": {
    "nodes": [
      {
        "id": "webhook-trigger-contact-extraction",
        "type": "webhook",
        "position": { "x": 50, "y": 380 },
        "data": {
          "label": "Contact Extraction Webhook",
          "toolId": "webhook",
          "toolData": {
            "id": "webhook",
            "displayName": "Webhook Trigger",
            "category": "Input / Output",
            "icon": "webhook",
            "description": "Trigger workflow via webhook"
          },
          "isTrigger": true,
          "isPrimaryTrigger": true,
          "inputs": {
            "path": "contact-extraction",
            "method": "POST",
            "responseMode": "respondWithNode",
            "authentication": "none",
            "sessionSource": "none",
            "options": { "allowedOrigins": "*" }
          }
        },
        "width": 220,
        "height": 100
      },
      {
        "id": "set-passthrough-fields",
        "type": "action",
        "position": { "x": 350, "y": 380 },
        "data": {
          "label": "Preserve file_id & batch_id",
          "toolId": "core.set",
          "toolData": {
            "id": "core.set",
            "displayName": "Set Fields",
            "category": "Core  Utilities",
            "provider": "core",
            "operation": "set",
            "description": "Set or update fields"
          },
          "isTrigger": false,
          "isPrimaryTrigger": false,
          "inputs": {
            "mode": "manual",
            "assignments": [
              { "name": "file_id",      "value": "{{ $json.body.file_id }}",                   "valueType": "expression" },
              { "name": "batch_id",     "value": "{{ $json.body.batch_id }}",                  "valueType": "expression" },
              { "name": "file_name",    "value": "{{ $json.body.file_name }}",                 "valueType": "expression" },
              { "name": "file_type",    "value": "{{ $json.body.file_type }}",                 "valueType": "expression" },
              { "name": "file_content", "value": "{{ $json.body.file_content }}",              "valueType": "expression" },
              { "name": "callback_url", "value": "{{ $json.body.callback_url }}",              "valueType": "expression" },
              { "name": "source_label", "value": "{{ $json.body.source_label || 'upload' }}", "valueType": "expression" }
            ],
            "includeOtherInputFields": false
          }
        },
        "width": 220,
        "height": 94
      },
      {
        "id": "switch-file-type",
        "type": "switch",
        "position": { "x": 650, "y": 380 },
        "data": {
          "label": "Route by File Type",
          "toolId": "core_switch",
          "toolData": {
            "id": "core_switch",
            "displayName": "Switch",
            "category": "Logic & Flow Control",
            "icon": "switch",
            "description": "Route workflow using conditions"
          },
          "isTrigger": false,
          "isPrimaryTrigger": false,
          "inputs": {
            "mode": "rules",
            "rules": [
              { "value1": "{{ $json.file_type }}", "operator": "contains", "value2": "pdf",   "outputIndex": 0 },
              { "value1": "{{ $json.file_type }}", "operator": "contains", "value2": "csv",   "outputIndex": 1 },
              { "value1": "{{ $json.file_type }}", "operator": "contains", "value2": "image", "outputIndex": 2 }
            ],
            "sendToAllMatches": false,
            "ignoreCase": true,
            "fallbackOutput": "fallback"
          }
        },
        "width": 240,
        "height": 129
      },

      {
        "id": "extract-pdf",
        "type": "action",
        "position": { "x": 980, "y": 80 },
        "data": {
          "label": "Extract From PDF",
          "toolId": "extract-from-file.extract-from-pdf",
          "toolData": {
            "id": "extract-from-file.extract-from-pdf",
            "displayName": "Extract From PDF",
            "category": "Knowledge / Context",
            "provider": "extractFromFile",
            "operation": "extract-from-pdf",
            "description": "Parse PDF content into JSON text"
          },
          "isTrigger": false,
          "isPrimaryTrigger": false,
          "inputs": { "pdfData": "{{ $json.file_content }}" }
        },
        "width": 220,
        "height": 94
      },
      {
        "id": "groq-pdf-extractor",
        "type": "action",
        "position": { "x": 1260, "y": 80 },
        "data": {
          "label": "Groq: Extract Contacts from PDF",
          "toolId": "groq",
          "toolData": {
            "id": "groq",
            "displayName": "Groq",
            "type": "chat model",
            "category": "AI / LLM",
            "provider": "LLM Models",
            "operation": "execute",
            "description": "Run ultra-fast LLM inference with Groq-hosted open-source models."
          },
          "isTrigger": false,
          "isPrimaryTrigger": false,
          "inputs": {
            "resource": "Text",
            "operation": "Chat",
            "model": "llama-3.1-8b-instant",
            "credentialId": "",
            "prompt": "Extract all contacts from this text. Return ONLY valid JSON: {\"contacts\":[{\"full_name\":null,\"first_name\":null,\"last_name\":null,\"designation\":null,\"company\":null,\"email\":null,\"phone\":null,\"address\":null,\"city\":null,\"state\":null,\"country\":null,\"sector_industry\":null,\"linkedin_url\":null,\"website\":null,\"source\":\"{{ $json.file_name }}\",\"validation_status\":\"valid\",\"duplicate_status\":\"unknown\"}]}. Use null for missing fields. No markdown.\n\nText:\n{{ ($json.text || $json.markdown || $json.content || '').slice(0, 6000) }}",
            "simplify": true,
            "outputContentAsJson": true,
            "options": {
              "systemMessage": "You are a contact extraction AI. Output only valid JSON. No prose, no markdown fences.",
              "maxTokens": 4096,
              "temperature": 0.05
            }
          }
        },
        "width": 220,
        "height": 94
      },
      {
        "id": "loop-pdf-contacts",
        "type": "loop",
        "position": { "x": 1560, "y": 80 },
        "data": {
          "label": "Loop PDF Contacts",
          "toolId": "core_loop",
          "toolData": {
            "id": "core_loop",
            "displayName": "Loop Items",
            "category": "Logic & Flow Control",
            "icon": "Repeat",
            "description": "Process items in loop"
          },
          "isTrigger": false,
          "isPrimaryTrigger": false,
          "inputs": {
            "inputField": "contacts",
            "batchSize": 1,
            "options": { "doneBranchOutput": "bundled" }
          }
        },
        "width": 220,
        "height": 210
      },
      {
        "id": "sheets-pdf",
        "type": "action",
        "position": { "x": 1880, "y": 80 },
        "data": {
          "label": "Append to Google Sheets (PDF)",
