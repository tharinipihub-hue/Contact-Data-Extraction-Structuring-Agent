PORT=4000
WORKBENCH_WEBHOOK_URL=https://YOUR_WORKBENCH_HOST/webhook/contact-extraction
WORKBENCH_WEBHOOK_SECRET=
# Set to the public backend URL only for Workbench workflows that POST callbacks.
# The primary workbench_workflow.json returns results synchronously.
BACKEND_CALLBACK_URL=
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
# Optional; used only by the direct Gemini image-extraction path.
GEMINI_API_KEY=
NURTURE_WORKBENCH_WEBHOOK_URL=https://api.agents.snsihub.ai/webhook/client-nurturing
NURTURE_WORKBENCH_TEST_WEBHOOK_URL=https://api.agents.snsihub.ai/webhook-test/client-nurturing
NURTURE_GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/1LffI4BEX2T1mdBIvy45gvauzqny8wPTCX3FaGvYVx2c/export?format=csv
NURTURE_SENDER_EMAIL=
FREEIMAGE_API_KEY=
PUBLIC_APP_URL=https://YOUR_RENDER_SERVICE.onrender.com
# Local development uses the project-local default when this is unset.
# Render Blueprint configures /var/data on its persistent disk.
# Set explicitly in production environments not managed by render.yaml.
NURTURE_DATA_DIR=

# Contact Research & Industry Intelligence (Tavily Search API)
# Get a free API key at https://tavily.com
TAVILY_API_KEY=

# Optional external calendar / occasion configuration endpoint
OCCASION_CONFIG_URL=
