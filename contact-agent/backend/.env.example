PORT=4000
WORKBENCH_WEBHOOK_URL=https://YOUR_WORKBENCH_HOST/webhook/contact-extraction
WORKBENCH_WEBHOOK_SECRET=
# Set to the public backend URL only for Workbench workflows that POST callbacks.
# The primary workbench_workflow.json returns results synchronously.
BACKEND_CALLBACK_URL=
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
# Optional; used only by the direct Gemini image-extraction path.
GEMINI_API_KEY=
NURTURE_WORKBENCH_WEBHOOK_URL=https://api.agents.snsihub.ai/webhook/client-nurturing
NURTURE_GOOGLE_SHEETS_CSV_URL=
NURTURE_SENDER_EMAIL=
FREEIMAGE_API_KEY=
PUBLIC_APP_URL=https://YOUR_RENDER_SERVICE.onrender.com
NURTURE_DATA_DIR=./nurture-data
# Optional public Google Sheets edit link shown in the React UI at build time.
REACT_APP_NURTURE_SHEET_MANAGEMENT_URL=
